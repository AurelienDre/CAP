<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter un lieu"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Nom du lieu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du lieu *"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextNomLieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le nom du lieu"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="20dp" />

        <!-- Photos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photos *"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/buttonAjouterPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sélectionner des photos"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewPhotosSelectionnees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune photo sélectionnée"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <!-- Plan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan *"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/buttonAjouterPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sélectionner le plan"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewPlanSelectionne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun plan sélectionné"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <!-- Contact optionnel -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact (optionnel)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Téléphone, email, etc."
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="20dp" />

        <!-- Descriptif -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descriptif *"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextDescriptif"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Décrivez le lieu..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/button_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous"

                android:textSize="16sp"/>

            <!-- Bouton de validation -->
            <Button
                android:id="@+id/buttonEnregistrer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Enregistrer"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
